[Unit]
Description=Lokamania 09 web application (Flask + gunicorn)
Documentation=https://github.com/Lilo10/Lokamania09_Source_Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lokamania
Group=lokamania
WorkingDirectory=/opt/lokamania/server

# The app reads ADMIN_PASSWORD / SECRET_KEY / EXCEL_PATH from
# /opt/lokamania/.env using its own loader (see server/app.py), which is
# safer here than systemd's EnvironmentFile parser.
Environment="PORT=8000"
Environment="PYTHONDONTWRITEBYTECODE=1"

# --workers 1 is deliberate: the Excel workbook is a single file, so all
# writes must be serialised inside one process.
ExecStart=/opt/lokamania/server/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    app:app

Restart=always
RestartSec=5
TimeoutStopSec=45

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/lokamania-data

[Install]
WantedBy=multi-user.target
